{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup src/*.ts --format esm --dts --clean",
    "dev": "tsup src/*.ts --format esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "tsup": "8.5.1",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0"
  }
}
