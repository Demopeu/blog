{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/tailwind.js",
  "types": "./dist/tailwind.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./panda": {
      "types": "./dist/panda.d.ts",
      "import": "./dist/panda.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "import": "./dist/shadcn/index.js"
    },
    "./shadcn/*": {
      "types": "./dist/shadcn/*.d.ts",
      "import": "./dist/shadcn/*.js"
    },
    "./react-bits": {
      "types": "./dist/react-bits/index.d.ts",
      "import": "./dist/react-bits/index.js"
    },
    "./react-bits/*": {
      "types": "./dist/react-bits/*.d.ts",
      "import": "./dist/react-bits/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js"
    },
    "./icon/*": {
      "types": "./dist/icon/*.d.ts",
      "import": "./dist/icon/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsup && postcss src/tailwind.css -o dist/tailwind.css",
    "build:js": "tsup",
    "build:css": "postcss src/tailwind.css -o dist/tailwind.css",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.546.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@repo/tailwind-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "postcss": "^8.5.9",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "@gsap/react": ">=2",
    "gl-matrix": ">=3",
    "gsap": ">=3",
    "motion": ">=12",
    "next": ">=15",
    "ogl": ">=1"
  },
  "peerDependenciesMeta": {
    "@gsap/react": {
      "optional": true
    },
    "gl-matrix": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "ogl": {
      "optional": true
    }
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  }
}
