{
  "name": "blog-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.25.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "start": "turbo start",
    "clean": "turbo clean",
    "check-types": "turbo run check-types",
    "check-before-commit": "turbo lint check-types",
    "prepare": "husky",
    "task": "bash scripts/g-start.sh",
    "done": "bash scripts/g-done.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "husky": "9.1.7",
    "prettier": "3.8.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.9.6",
    "typescript": "6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.0"
}
